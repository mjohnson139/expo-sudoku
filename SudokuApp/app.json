{
  "expo": {
    "name": "SudokuApp",
    "slug": "expo-sudoku",
    "version": "2.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/e6c3fb8f-7922-4b6d-8721-3d52df091af9"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mjohnson139.sudokuapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Sudoku App",
      "shortName": "Sudoku",
      "backgroundColor": "#ffffff",
      "themeColor": "#000000",
      "description": "A beautifully designed Sudoku game",
      "lang": "en",
      "orientation": "portrait"
    },
    "extra": {
      "eas": {
        "projectId": "e6c3fb8f-7922-4b6d-8721-3d52df091af9"
      }
    },
    "owner": "mjohnson139",
    "plugins": [
      "expo-font",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ]
  }
}
